{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/opportunity.html",
      "destination": "/index.html",
      "permanent": true
    },
    {
      "source": "/opportunity",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/program.html",
      "destination": "/offer.html",
      "permanent": true
    },
    {
      "source": "/program",
      "destination": "/offer",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/offer.html",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/offer",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ]
}
